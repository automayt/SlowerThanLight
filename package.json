{
  "name": "slower-than-light",
  "private": true,
  "version": "0.1.0",
  "description": "FTL-style pirate ship combat on the high seas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p server --noEmit && vite build",
    "server": "tsx server/index.ts",
    "coop": "vite build && tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:fuzz": "vitest run tests/sim/fuzz.test.ts",
    "balance": "tsx scripts/balance.ts"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "phaser": "^3.90.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
